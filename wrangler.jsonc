{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ovelle",
  "account_id": "47b7e4cbf6e4918eecb9241815337c9e",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "env": {
    "development": {
      "name": "ovelle-development",
      "vars": { "APP_ENV": "development" },
      "assets": {
        "binding": "ASSETS",
        "directory": "./apps/web/dist",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ovelle-db-development",
          "database_id": "6faa4ab6-6773-4078-9fe4-01ef0972a458"
        }
      ],
      "r2_buckets": [
        { "binding": "STORAGE", "bucket_name": "ovelle-storage-development" }
      ]
    },
    "production": {
      "name": "ovelle-production",
      "vars": { "APP_ENV": "production" },
      "assets": {
        "binding": "ASSETS",
        "directory": "./apps/web/dist",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ovelle-db-production",
          "database_id": "692c48ec-2b6c-402e-bfa1-eb93730c1bd2"
        }
      ],
      "r2_buckets": [
        { "binding": "STORAGE", "bucket_name": "ovelle-storage-production" }
      ]
    }
  }
}
