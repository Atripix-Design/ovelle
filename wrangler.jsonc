{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ovelle",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "env": {
    "development": {
      "name": "ovelle-development",
      "routes": [
        {
          "pattern": "dev.ovelle.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "development",
        "RELEASE_VERSION": "0.1.0",
        "DOWNLOAD_EMAIL_FROM": "downloads@dev.mail.ovelle.org",
        "R2_BUCKET_NAME": "ovelle-storage-development"
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./apps/web/dist",
        "run_worker_first": [
          "/api/*",
          "/health",
          "/downloads/*"
        ],
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ovelle-db-development",
          "database_id": "d5d4e909-cac1-4ce4-ad56-888cdb24a05a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "ovelle-storage-development"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": [
            "downloads@dev.mail.ovelle.org"
          ]
        },
        {
          "name": "AUTH_EMAIL",
          "allowed_sender_addresses": [
            "accounts@dev.mail.ovelle.org"
          ]
        }
      ]
    },
    "production": {
      "name": "ovelle-production",
      "routes": [
        {
          "pattern": "ovelle.org",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "R2_BUCKET_NAME": "ovelle-storage-production"
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./apps/web/dist",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ovelle-db-production",
          "database_id": "03263655-7eca-4586-a46f-9e502d52675b"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "ovelle-storage-production"
        }
      ]
    }
  }
}
