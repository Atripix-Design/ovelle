{
  "name": "ovelle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @ovelle/web",
    "dev:desktop": "npm run dev -w @ovelle/desktop",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && npm run check:worker && npm run check:stage0",
    "lint": "npm run lint --workspaces",
    "check:worker": "tsc -p tsconfig.worker.json",
    "cf:deploy:dev": "npm run build -w @ovelle/ui && npm run build:development -w @ovelle/web && node scripts/ci/deploy-worker.mjs development",
    "cf:deploy:prod": "npm run build -w @ovelle/ui && npm run build -w @ovelle/web && node scripts/ci/deploy-worker.mjs production",
    "check:figma": "node scripts/check-figma-fidelity.mjs",
    "check:components": "node scripts/check-content-components.mjs",
    "check:loading": "node scripts/check-dynamic-loading.mjs",
    "check:website": "node scripts/check-website.mjs",
    "check:download-email": "node --experimental-strip-types scripts/check-download-email.mjs",
    "check:electron-downloads": "node scripts/check-electron-downloads.mjs",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "check:ci": "node --test scripts/ci/*.test.mjs",
    "test:stage0-probe": "node --test scripts/stage0-hosted-probe.test.mjs",
    "test:stage0": "vitest run --config vitest.stage0.config.mts",
    "test:stage0-passkey-browser": "node scripts/verify-stage0-passkey-browser.mjs",
    "benchmark:stage0-password": "node --experimental-strip-types scripts/benchmark-stage0-password.ts",
    "check:stage0": "tsc -p tsconfig.stage0.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@noble/hashes": "2.4.0",
    "esbuild": "0.28.2",
    "js-yaml": "^4.3.2",
    "miniflare": "5.20261019.2-beta",
    "playwright": "^1.64.0",
    "vitest": "4.1.12",
    "wrangler": "4.152.0",
    "xml-crypto": "6.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@node-saml/node-saml": "5.1.0",
    "@simplewebauthn/server": "14.0.3",
    "@xmldom/xmldom": "0.9.12",
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  }
}
