{
  "name": "ovelle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @ovelle/web",
    "dev:desktop": "npm run dev -w @ovelle/desktop",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && npm run check:worker",
    "lint": "npm run lint --workspaces",
    "check:worker": "tsc -p tsconfig.worker.json",
    "cf:deploy:dev": "npm run build:development -w @ovelle/web && wrangler deploy --env development",
    "cf:deploy:prod": "npm run build -w @ovelle/web && wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0"
  }
}
