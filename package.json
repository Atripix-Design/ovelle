{
  "name": "ovelle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @ovelle/web",
    "dev:desktop": "npm run dev -w @ovelle/desktop",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && npm run check:worker",
    "lint": "npm run lint --workspaces",
    "check:worker": "tsc -p tsconfig.worker.json",
    "cf:deploy:dev": "npm run build -w @ovelle/ui && npm run build:development -w @ovelle/web && node scripts/ci/deploy-worker.mjs development",
    "cf:deploy:prod": "npm run build -w @ovelle/ui && npm run build -w @ovelle/web && node scripts/ci/deploy-worker.mjs production",
    "check:figma": "node scripts/check-figma-fidelity.mjs",
    "check:components": "node scripts/check-content-components.mjs",
    "check:loading": "node scripts/check-dynamic-loading.mjs",
    "check:website": "node scripts/check-website.mjs",
    "check:download-email": "node --experimental-strip-types scripts/check-download-email.mjs",
    "check:electron-downloads": "node scripts/check-electron-downloads.mjs",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "check:ci": "node --test scripts/ci/ci.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "playwright": "^1.64.0",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0"
  }
}
