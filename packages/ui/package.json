{
  "name": "@ovelle/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/styles.css",
    "figma-manifest.json",
    "README.md",
    "src/tokens.css",
    "tokens.json",
    "assets",
    "src/base.css",
    "src/controls.css",
    "src/composites.css",
    "src/content.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./figma-manifest.json": "./figma-manifest.json",
    "./tokens.json": "./tokens.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
