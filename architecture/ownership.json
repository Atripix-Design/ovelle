  "concepts": [
    {
      "owner": "src/cloudflare/stage0/access/policy.ts",
      "reason": "Live tenant and scope policy for reads and transactional write guards."
    },
    {
      "owner": "src/cloudflare/stage0/auth/contact.ts",
      "reason": "Account contact normalization; email does not establish identity linking."
    },
    {
      "owner": "src/cloudflare/stage0/auth/sessions.ts",
      "reason": "Session issuance, live authority and revocation."
    },
    {
      "owner": "src/cloudflare/stage0/commands.ts",
      "reason": "Command receipt and idempotent commit coordination."
    },
    {
      "owner": "packages/ui/src/material.tsx",
      "reason": "Shared material settings and normalization."
    },
    {
      "owner": "packages/ui/tokens.json",
      "reason": "Design token source; CSS parity requires design-system checks."
    },
    {
      "owner": "src/cloudflare/download-email.ts",
      "reason": "Public download email validation and delivery, separate from account identity."
    },
    {
      "owner": "src/cloudflare/stage0/domain/access.ts",
      "reason": "Closed action vocabulary, grant classification, write classification and scope validation; consumed by SQL enforcement and grant issuance."
    },
    {
      "owner": "src/cloudflare/stage0/auth/contact-delivery.ts",
      "reason": "Verification email construction and explicit delivery outcome; separate from pure normalization."
    },
    {
      "owner": "src/cloudflare/stage0/errors.ts",
      "reason": "Closed failure vocabulary and safe HTTP status mapping; never arbitrary provider messages."
    },
    {
      "owner": "src/cloudflare/stage0/http/response.ts",
      "reason": "Private-response security headers and bodyless response handling; applied in place to preserve separate cookies."
    },
    {
      "owner": "src/cloudflare/stage0/http/body.ts",
      "reason": "Bounded UTF-8 JSON stream decoding for requests and provider responses, without route dependencies."
    },
    {
      "owner": "src/cloudflare/stage0/domain/base64url.ts",
      "reason": "Canonical unpadded URL-safe byte encoding shared by secret and protocol adapters."
    },
    {
      "owner": "src/cloudflare/stage0/auth/secrets.ts",
      "reason": "Random secret generation, format and stored digest; domain-specific MAC inputs remain at their callers."
    },
    {
      "owner": "scripts/browser-tooling.mjs",
      "reason": "Installed browser and recording provider selection and interface validation for operator-run verification tools."
    },
    {
      "owner": "apps/desktop/src/contracts/downloads.ts",
      "reason": "Closed download IPC channel vocabulary shared by main and preload without native capabilities."
    },
    {
      "owner": "apps/desktop/src/main/downloads.ts",
      "reason": "Download IPC sender authorization and development service transport; rechecks the sender on every call."
    },
    {
      "owner": "apps/desktop/src/main/index.ts",
      "reason": "Native window lifecycle, sandbox configuration and external navigation allowlist."
    },
    {
      "owner": "src/cloudflare/stage0/staff/validation.ts",
      "reason": "Pure staff identifier/version validation, strict invitation address normalization and canonical grant offers."
    },
    {
      "owner": "src/cloudflare/stage0/staff/invitation-delivery.ts",
      "reason": "Post-commit staff invitation mail and version/token-guarded delivery outcome persistence."
    },
    {
      "owner": "src/cloudflare/stage0/staff/invitations.ts",
      "reason": "Invitation transitions and live issuer/recipient authority, kept with atomic guarded SQL and receipts."
    }
  ],
  "sourceMappings": [
    {
      "output": "packages/ui/dist/",
      "source": "packages/ui/src/"
    }
  ]
}
