[Unit]
Description=Ovelle ubuntu-box CI and Cloudflare delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/GitHub/ovelle
Environment=XDG_CONFIG_HOME=%h/.config/ovelle-auth-flow
Environment=CLOUDFLARE_ACCOUNT_ID=83952a1be987e4a12647732861a60925
ExecStart=%h/.local/bin/node %h/Documents/GitHub/ovelle/scripts/ci/host-ci.mjs
TimeoutStartSec=45min
